{
    // --- Language Server (clangd) Configuration ---
    // Professional Tip: clangd is far superior for ESP-IDF. It parses the
    // compile_commands.json generated by CMake, providing perfect
    // "Go to Definition" even through complex FreeRTOS and IDF layers.
    "clangd.arguments": [
        "--background-index",
        "--suggest-missing-includes",
        "--header-insertion=never",
        "--completion-style=detailed",
        "--function-arg-placeholders",
        "-j=4",
        "--fallback-style=llvm",
        // Point to the build folder where CMake generates compile_commands.json
        "--compile-commands-dir=build"
    ],
    "editor.semanticHighlighting.enabled": true,
    // --- Conflict Resolution ---
    // Disable Microsoft C++ Intellisense to let clangd take full control.
    "C_Cpp.intelliSenseEngine": "disabled",
    // --- Search & Performance ---
    // Embedded projects generate a lot of build noise. We exclude 'build'
    // and 'sdkconfig.old' to keep global searches fast and relevant.
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/build": false,
        "**/sdkconfig.old": true
    },
    "search.exclude": {
        "**/build": false, // We want to search build for symbols, but not show it in the explorer
        "**/sdkconfig.old": true,
        "**/managed_components": true
    },
    // --- Code Style & Formatting (Embedded Standard) ---
    // We enforce 4-space indentation and auto-formatting on save to
    // maintain a clean, professional codebase.
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // --- File Associations ---
    // Maps ESP-IDF specific configuration files to appropriate highlighting.
    "files.associations": {
        "sdkconfig*": "properties",
        "Kconfig*": "makefile",
        "*.h": "c",
        "*.c": "c"
    },
    // --- UI Cleanliness (File Nesting) ---
    // This hides the "noise" of the build system in the explorer sidebar.
    // Project files are nested under CMakeLists.txt for a cleaner look.
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "CMakeLists.txt": "project.cmake, idf_component.yml, Kconfig*, .gitignore",
        "*.c": "${capture}.h",
        "sdkconfig": "sdkconfig.old, sdkconfig.defaults"
    }
}
